        {
         "key": "token",
         "value": "{{employeeToken}}",
         "type": "string"
        }
       ]
      }
     }
    },
    {
     "name": "Download uploaded file without token",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/files/{{filename}}",
      "auth": {
       "type": "noauth"
      }
     }
    }
   ]
  }
 ]
